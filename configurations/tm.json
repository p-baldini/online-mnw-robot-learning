{
    "output":               {
        "path":                 "../../tm/",
        "log_file":             "log",
        "performance_file":     "performance.dat",
        "state_file":           "state.dat",
        "coupling_file":        "coupling.dat"
    },

    "task":                 {
        "type":                 "T-MAZE",
        "continuous":           true,
        "starting_seed":        1,
        "robots_count":         1,

        "replicas_count":       100,
        "epochs_count":         1000,
        "epochs_duration":      2000,
        "time_step_ms":         100,

        "history_weight":       1.0,
        "discount_weight":      1.0,

        "max_step_prize":       1,
        "max_step_penalty":     0
    },

    "nn_network":           {
        "wires_count":          750,
        "package_size":         500,
        "wires_length":         40.0,
        "max_stimulation_v":    3.3
    },

    "actuators":            {
        "active":               [ "left wheel motor", "right wheel motor" ],
        "min_output":           -6.28,
        "max_output":           6.28,
        "loads":                1e-4
    },

    "sensors":              {
        "active":               [ "ps0", "ps7", "gs0" ],
        "max_input":            1024,
        "multipliers":          {
            "creation_mu":          1.0,
            "creation_sigma":       0.0,
            "modification_mu":      0.0,
            "modification_sigma":   0.0
        }
    }
}